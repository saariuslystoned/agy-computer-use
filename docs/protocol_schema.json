{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComputerUseIPCProtocol",
  "description": "IPC Request and Response Schemas between MCP Server and ComputerUseHost Native App",
  "oneOf": [
    { "$ref": "#/definitions/IPCRequest" },
    { "$ref": "#/definitions/IPCResponse" }
  ],
  "definitions": {
    "IPCRequest": {
      "type": "object",
      "required": ["id", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "enum": ["status", "observe", "ax_tree", "click", "move", "drag", "type", "shortcut", "scroll"]
        },
        "params": {
          "type": "object",
          "properties": {
            "display_id": { "type": "integer" },
            "max_depth": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 },
            "app_id": { "type": "string" },
            "x": { "type": "integer", "minimum": 0, "maximum": 999 },
            "y": { "type": "integer", "minimum": 0, "maximum": 999 },
            "start_x": { "type": "integer", "minimum": 0, "maximum": 999 },
            "start_y": { "type": "integer", "minimum": 0, "maximum": 999 },
            "end_x": { "type": "integer", "minimum": 0, "maximum": 999 },
            "end_y": { "type": "integer", "minimum": 0, "maximum": 999 },
            "button": { "type": "string", "enum": ["left", "right", "middle"] },
            "click_count": { "type": "integer", "minimum": 1, "maximum": 3 },
            "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "press_enter": { "type": "boolean" },
            "keys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "delta_x": { "type": "integer" },
            "delta_y": { "type": "integer" },
            "direction": { "type": "string", "enum": ["up", "down", "left", "right"] },
            "capture_id": { "type": "string", "minLength": 1 },
            "topology_version": { "type": "string", "minLength": 1 },
            "intent": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "enum": ["click", "move", "scroll"] } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["x", "y", "capture_id", "topology_version", "intent"]
              }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "drag" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["start_x", "start_y", "end_x", "end_y", "capture_id", "topology_version", "intent"]
              }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "type" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["text", "capture_id", "topology_version", "intent"]
              }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "shortcut" } } },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["keys", "capture_id", "topology_version", "intent"]
              }
            }
          }
        }
      ]
    },
    "IPCResponse": {
      "type": "object",
      "required": ["id", "success"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "success": { "type": "boolean" },
        "data": { "type": "object" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": { "type": "object" }
          }
        }
      }
    },
    "AXNode": {
      "type": "object",
      "required": ["role", "bounds"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "subrole": { "type": "string" },
        "title": { "type": "string" },
        "value": { "type": "string" },
        "enabled": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "bounds": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/AXNode" }
        }
      }
    }
  }
}
