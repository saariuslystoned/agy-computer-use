#!/usr/bin/env node

import { execSync } from "child_process";
import * as fs from "fs";
import * as path from "path";
import { fileURLToPath, pathToFileURL } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "..");
const mcpPkgDir = path.join(rootDir, "mcp/computer-use-mcp");

function log(msg) {
  console.log(`[bin/agy-computer-use] ${msg}`);
}

function fail(msg) {
  console.error(`[FAIL] ${msg}`);
  process.exit(1);
}

const subcommand = process.argv[2] || "doctor";
const validSubcommands = ["build", "doctor", "production-ready", "canary-ready", "test-native", "stage-host-app", "host-principal"];

if (!validSubcommands.includes(subcommand)) {
  console.error(`[FAIL] Unknown subcommand '${subcommand}'. Valid subcommands are: ${validSubcommands.join(", ")}`);
  process.exit(1);
}

function validateMcpConfigStruct() {
  const mcpConfigPath = path.join(rootDir, ".agents/mcp_config.json");
  if (!fs.existsSync(mcpConfigPath)) {
    throw new Error(`.agents/mcp_config.json missing at ${mcpConfigPath}`);
  }

  const mcpConfig = JSON.parse(fs.readFileSync(mcpConfigPath, "utf-8"));
  const keys = Object.keys(mcpConfig?.mcpServers || {});
  if (keys.length !== 1 || keys[0] !== "computer-use") {
    throw new Error(`.agents/mcp_config.json must contain EXACTLY ONE active MCP server key: 'computer-use', got ${JSON.stringify(keys)}`);
  }

  const prodServer = mcpConfig.mcpServers["computer-use"];
  if (prodServer.command !== "node") {
    throw new Error(`computer-use server command must be 'node'`);
  }
  if (!Array.isArray(prodServer.args) || prodServer.args.length !== 1 || prodServer.args[0] !== "./mcp/computer-use-mcp/dist/src/index.js") {
    throw new Error(`computer-use server args must be strictly ['./mcp/computer-use-mcp/dist/src/index.js']`);
  }
  if (prodServer.cwd !== ".") {
    throw new Error(`computer-use server cwd must be '.'`);
  }
  if (!fs.existsSync(path.join(rootDir, prodServer.args[0]))) {
    throw new Error(`Target dist file for computer-use does not exist at ${prodServer.args[0]}`);
  }
}

async function verifyProductionMcpConfiguredStdio() {
  validateMcpConfigStruct();

  const clientSdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/client/index.js");
  const stdioSdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/client/stdio.js");

  const { Client } = await import(pathToFileURL(clientSdkPath).href);
  const { StdioClientTransport } = await import(pathToFileURL(stdioSdkPath).href);

  const mcpConfigPath = path.join(rootDir, ".agents/mcp_config.json");
  const mcpConfig = JSON.parse(fs.readFileSync(mcpConfigPath, "utf-8"));
  const prodServer = mcpConfig.mcpServers["computer-use"];

  const transport = new StdioClientTransport({
    command: prodServer.command,
    args: prodServer.args,
    cwd: rootDir
  });

  const client = new Client(
    { name: "production-ready-client", version: "1.0.0" },
    { capabilities: {} }
  );

  await client.connect(transport);
  const toolsResult = await client.listTools();
  await client.close();
  await transport.close();

  if (!toolsResult || !toolsResult.tools || toolsResult.tools.length !== 2) {
    throw new Error(`Public production MCP tool inventory count must be EXACTLY 2, got ${toolsResult?.tools?.length ?? 0}`);
  }

  const toolNames = toolsResult.tools.map(t => t.name).sort();
  if (toolNames[0] !== "computer_use_observe" || toolNames[1] !== "computer_use_status") {
    throw new Error(`Production tool names must be ['computer_use_observe', 'computer_use_status'], got ${JSON.stringify(toolNames)}`);
  }

  return toolNames;
}

async function main() {
  if (subcommand === "stage-host-app") {
    log("Staging ComputerUseHost.app background principal bundle...");
    execSync("node bin/host-app.mjs stage", { cwd: rootDir, stdio: "inherit" });
    process.exit(0);
  }

  if (subcommand === "host-principal") {
    log("Classifying ComputerUseHost.app principal...");
    const extraArgs = process.argv.slice(3).join(" ");
    execSync(`node bin/host-app.mjs classify ${extraArgs}`, { cwd: rootDir, stdio: "inherit" });
    process.exit(0);
  }

  if (subcommand === "build") {
    log("Building mcp/computer-use-mcp package...");
    execSync("pnpm build", { cwd: mcpPkgDir, stdio: "inherit" });
    log("Build complete.");
    process.exit(0);
  }

  if (subcommand === "test-native") {
    log("Building and running native test suite with strict concurrency flags...");
    const hostDir = path.join(rootDir, "apps/computer-use-host");
    const manifestPath = path.join(rootDir, "docs/native_test_manifest.txt");

    let helpOutput = "";
    let listOutput = "";
    let listExitCode = 0;

    try {
      helpOutput = execSync("swift test list --help 2>&1", { cwd: hostDir, encoding: "utf-8" });
      const enableFlag = helpOutput.includes("--enable-xctest") ? " --enable-xctest" : "";
      listOutput = execSync(`swift test list${enableFlag} 2>&1`, { cwd: hostDir, encoding: "utf-8" });
      listExitCode = 0;
    } catch (err) {
      listOutput = (err.stdout || "") + "\n" + (err.stderr || "") + "\n" + (err.message || "");
      listExitCode = err.status || 1;
    }

    let manifestContent = "";
    try {
      manifestContent = fs.readFileSync(manifestPath, "utf-8");
    } catch (err) {
      fail(`Failed to read native test manifest at ${manifestPath}: ${err.message}`);
    }

    const selectionModulePath = path.join(mcpPkgDir, "src/native-authority-selection-core.js");
    const { classifyNativeAuthoritySelection } = await import(pathToFileURL(selectionModulePath).href);
    const selection = classifyNativeAuthoritySelection({
      helpOutput,
      listOutput,
      listExitCode,
      manifestContent
    });

    if (selection.status !== 0) {
      fail(selection.error || "'swift test list' failed closed");
    }

    if (selection.authority === "fallback") {
      log("XCTest discovery unavailable in environment; running ComputerUseHostTestRunner executable authority...");
      execSync("swift run -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors ComputerUseHostTestRunner", { cwd: hostDir, stdio: "inherit" });
      log("Native test suite execution complete.");
      process.exit(0);
    }

    if (selection.authority === "xctest") {
      log(`Executing native test suite (${selection.testCount} discovered tests)...`);
      const enableFlag = helpOutput.includes("--enable-xctest") ? " --enable-xctest" : "";
      execSync(`swift test${enableFlag} -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors`, { cwd: hostDir, stdio: "inherit" });
      log("Native test suite execution complete.");
      process.exit(0);
    }

    fail(`Unrecognized selection authority: ${selection.authority}`);
  }

  if (subcommand === "doctor" || subcommand === "production-ready" || subcommand === "canary-ready") {
    log(`Validating production-only configured stdio readiness (subcommand: ${subcommand})...`);

    // ALWAYS build current TypeScript sources before verification
    execSync("pnpm build", { cwd: mcpPkgDir, stdio: "ignore" });

    try {
      const nodeVer = process.version;
      log(`Node.js version: ${nodeVer}`);
    } catch {
      fail("Node.js missing in environment.");
    }

    try {
      validateMcpConfigStruct();
      log("Verified .agents/mcp_config.json strict single-server 'computer-use' registration.");
    } catch (err) {
      fail(`MCP Config validation failed: ${err.message}`);
    }

    try {
      const toolNames = await verifyProductionMcpConfiguredStdio();
      log(`Verified production configured stdio MCP tool inventory: Exactly 2 tools (${toolNames.join(", ")})`);
    } catch (err) {
      fail(`Configured stdio MCP tool inventory check failed: ${err.message}`);
    }

    log("ALL PRODUCTION CONFIGURED STDIO READINESS CHECKS PASSED!");
    process.exit(0);
  }
}

main().catch((err) => {
  fail(err.message);
});
