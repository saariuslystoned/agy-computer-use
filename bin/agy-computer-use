#!/usr/bin/env node

import { execSync } from "child_process";
import * as fs from "fs";
import * as path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "..");
const mcpPkgDir = path.join(rootDir, "mcp/computer-use-mcp");

function log(msg) {
  console.log(`[bin/agy-computer-use] ${msg}`);
}

function fail(msg) {
  console.error(`[FAIL] ${msg}`);
  process.exit(1);
}

const subcommand = process.argv[2] || "doctor";
const validSubcommands = ["build", "doctor", "canary-ready", "test-native"];

if (!validSubcommands.includes(subcommand)) {
  console.error(`[FAIL] Unknown subcommand '${subcommand}'. Valid subcommands are: ${validSubcommands.join(", ")}`);
  process.exit(1);
}

async function verifyD2McpToolInventory() {
  const indexModulePath = path.join(mcpPkgDir, "dist/src/index.js");
  const hostClientModulePath = path.join(mcpPkgDir, "dist/src/host-client.js");

  const clientSdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/client/index.js");
  const memorySdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/inMemory.js");

  if (!fs.existsSync(indexModulePath)) {
    throw new Error(`D2 Server dist module missing at ${indexModulePath}`);
  }

  const { Client } = await import(`file://${clientSdkPath}`);
  const { InMemoryTransport } = await import(`file://${memorySdkPath}`);
  const { createComputerUseServer } = await import(`file://${indexModulePath}`);
  const { MockHostClient } = await import(`file://${hostClientModulePath}`);

  const mockClient = new MockHostClient();
  const server = createComputerUseServer(mockClient);

  const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
  const client = new Client(
    { name: "doctor-inventory-client", version: "1.0.0" },
    { capabilities: {} }
  );

  await Promise.all([
    server.connect(serverTransport),
    client.connect(clientTransport)
  ]);

  const toolsResult = await client.listTools();
  await client.close();
  await server.close();

  if (!toolsResult || !toolsResult.tools || toolsResult.tools.length !== 2) {
    throw new Error(`D2 MCP server tool inventory count must be EXACTLY 2, got ${toolsResult?.tools?.length ?? 0}`);
  }

  const toolNames = toolsResult.tools.map(t => t.name).sort();
  if (toolNames[0] !== "computer_use_observe" || toolNames[1] !== "computer_use_status") {
    throw new Error(`D2 tool names must be ['computer_use_observe', 'computer_use_status'], got ${JSON.stringify(toolNames)}`);
  }

  return toolNames;
}

function validateMcpConfigStruct() {
  const mcpConfigPath = path.join(rootDir, ".agents/mcp_config.json");
  if (!fs.existsSync(mcpConfigPath)) {
    throw new Error(`.agents/mcp_config.json missing at ${mcpConfigPath}`);
  }

  const mcpConfig = JSON.parse(fs.readFileSync(mcpConfigPath, "utf-8"));

  const prodServer = mcpConfig?.mcpServers?.["computer-use"];
  if (!prodServer) {
    throw new Error(`.agents/mcp_config.json must register 'computer-use'`);
  }
  if (prodServer.command !== "node" || prodServer.args[0] !== "./mcp/computer-use-mcp/dist/src/index.js") {
    throw new Error(`computer-use server config must point to './mcp/computer-use-mcp/dist/src/index.js'`);
  }
  if (!fs.existsSync(path.join(rootDir, prodServer.args[0]))) {
    throw new Error(`Target dist file for computer-use does not exist at ${prodServer.args[0]}`);
  }

  const canaryServer = mcpConfig?.mcpServers?.["computer-use-canary"];
  if (!canaryServer) {
    throw new Error(`.agents/mcp_config.json must register 'computer-use-canary'`);
  }
  if (canaryServer.command !== "node" || canaryServer.args[0] !== "./mcp/computer-use-mcp/dist/src/canary.js") {
    throw new Error(`computer-use-canary server config must point to './mcp/computer-use-mcp/dist/src/canary.js'`);
  }
  if (!fs.existsSync(path.join(rootDir, canaryServer.args[0]))) {
    throw new Error(`Target dist file for computer-use-canary does not exist at ${canaryServer.args[0]}`);
  }
}

async function main() {
  if (subcommand === "build") {
    log("Building mcp/computer-use-mcp package...");
    execSync("pnpm build", { cwd: mcpPkgDir, stdio: "inherit" });
    log("Build complete.");
    process.exit(0);
  }

  if (subcommand === "test-native") {
    log("Building and running native test suite with strict concurrency flags...");
    const hostDir = path.join(rootDir, "apps/computer-use-host");
    const manifestPath = path.join(rootDir, "docs/native_test_manifest.txt");

    let hasXCTest = false;
    let actualList = "";
    try {
      const testListRaw = execSync("swift test list 2>/dev/null", { cwd: hostDir, encoding: "utf-8" });
      actualList = testListRaw.trim().split("\n").map(l => l.trim()).filter(Boolean).sort().join("\n");
      if (actualList.length > 0) {
        hasXCTest = true;
      }
    } catch {
      hasXCTest = false;
    }

    if (hasXCTest) {
      log("Verifying native test manifest matches 'swift test list'...");
      const expectedList = fs.readFileSync(manifestPath, "utf-8").trim().split("\n").map(l => l.trim()).filter(Boolean).sort().join("\n");
      if (actualList !== expectedList) {
        fail(`Native test manifest mismatch!\nExpected:\n${expectedList}\nActual:\n${actualList}`);
      }
      execSync("swift test -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors", { cwd: hostDir, stdio: "inherit" });
    } else {
      log("XCTest discovery unavailable in environment; running ComputerUseHostTestRunner executable authority...");
      execSync("swift run -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors ComputerUseHostTestRunner", { cwd: hostDir, stdio: "inherit" });
    }

    log("Native test suite execution complete.");
    process.exit(0);
  }

  if (subcommand === "doctor" || subcommand === "canary-ready") {
    log("Validating offline readiness for Milestone D2 (building TypeScript sources)...");

    // ALWAYS build current TypeScript sources before verification
    execSync("pnpm build", { cwd: mcpPkgDir, stdio: "ignore" });

    try {
      const nodeVer = process.version;
      log(`Node.js version: ${nodeVer}`);
    } catch {
      fail("Node.js missing in environment.");
    }

    try {
      validateMcpConfigStruct();
      log("Verified .agents/mcp_config.json computer-use & computer-use-canary server registrations.");
    } catch (err) {
      fail(`MCP Config validation failed: ${err.message}`);
    }

    try {
      const toolNames = await verifyD2McpToolInventory();
      log(`Verified D2 public MCP tool inventory: Exactly 2 tools (${toolNames.join(", ")})`);
    } catch (err) {
      fail(`Public MCP Client tool inventory check failed: ${err.message}`);
    }

    log("ALL OFFLINE D2 READINESS CHECKS PASSED!");
    process.exit(0);
  }
}

main().catch((err) => {
  fail(err.message);
});
