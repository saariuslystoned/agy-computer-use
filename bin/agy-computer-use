#!/usr/bin/env node

import { execSync } from "child_process";
import * as fs from "fs";
import * as path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, "..");
const mcpPkgDir = path.join(rootDir, "mcp/computer-use-mcp");

function log(msg) {
  console.log(`[bin/agy-computer-use] ${msg}`);
}

function fail(msg) {
  console.error(`[FAIL] ${msg}`);
  process.exit(1);
}

const subcommand = process.argv[2] || "doctor";
const validSubcommands = ["build", "doctor", "canary-ready"];

if (!validSubcommands.includes(subcommand)) {
  console.error(`[FAIL] Unknown subcommand '${subcommand}'. Valid subcommands are: ${validSubcommands.join(", ")}`);
  process.exit(1);
}

async function verifyPublicMcpToolInventory() {
  const canaryModulePath = path.join(mcpPkgDir, "dist/src/canary.js");
  const mockClientModulePath = path.join(mcpPkgDir, "dist/src/peekaboo-client.js");

  const clientSdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/client/index.js");
  const memorySdkPath = path.join(mcpPkgDir, "node_modules/@modelcontextprotocol/sdk/dist/esm/inMemory.js");

  if (!fs.existsSync(canaryModulePath)) {
    throw new Error(`Canary dist module missing at ${canaryModulePath}`);
  }

  const { Client } = await import(`file://${clientSdkPath}`);
  const { InMemoryTransport } = await import(`file://${memorySdkPath}`);
  const { createCanaryServer } = await import(`file://${canaryModulePath}`);
  const { MockPeekabooImageClient } = await import(`file://${mockClientModulePath}`);

  const mockClient = new MockPeekabooImageClient();
  const server = createCanaryServer(mockClient);

  const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
  const client = new Client(
    { name: "doctor-inventory-client", version: "1.0.0" },
    { capabilities: {} }
  );

  await Promise.all([
    server.connect(serverTransport),
    client.connect(clientTransport)
  ]);

  const toolsResult = await client.listTools();
  await client.close();
  await server.close();

  if (!toolsResult || !toolsResult.tools || toolsResult.tools.length !== 1) {
    throw new Error(`Canary server tool inventory count must be EXACTLY 1, got ${toolsResult?.tools?.length ?? 0}`);
  }

  if (toolsResult.tools[0].name !== "computer_use_canary_screenshot") {
    throw new Error(`Canary tool name must be 'computer_use_canary_screenshot', got '${toolsResult.tools[0].name}'`);
  }

  return toolsResult.tools[0].name;
}

function checkPeekabooPermissions() {
  const peekabooBin = fs.existsSync("/opt/homebrew/bin/peekaboo") ? "/opt/homebrew/bin/peekaboo" : "peekaboo";
  const permRaw = execSync(`${peekabooBin} permissions --json`, { encoding: "utf-8" }).trim();
  const permJson = JSON.parse(permRaw);

  if (!permJson || permJson.success !== true) {
    throw new Error("Peekaboo permissions check returned success != true");
  }

  const perms = permJson.data?.permissions || [];
  const screenRec = perms.find((p) => p.name === "Screen Recording");
  if (!screenRec || screenRec.isGranted !== true) {
    throw new Error("Peekaboo Screen Recording permission is NOT granted");
  }

  return true;
}

async function main() {
  if (subcommand === "build") {
    log("Building mcp/computer-use-mcp package...");
    execSync("pnpm build", { cwd: mcpPkgDir, stdio: "inherit" });
    log("Build complete.");
    process.exit(0);
  }

  if (subcommand === "doctor") {
    log("Running agy-computer-use doctor report...");

    try {
      const nodeVer = process.version;
      const pnpmVer = execSync("pnpm --version", { encoding: "utf-8" }).trim();
      log(`Toolchain: Node.js ${nodeVer}, pnpm ${pnpmVer}`);
    } catch {
      log("Warning: Toolchain check failed.");
    }

    try {
      execSync("pnpm build", { cwd: mcpPkgDir, stdio: "ignore" });
      const toolName = await verifyPublicMcpToolInventory();
      log(`Public MCP Server Inventory: 1 tool ('${toolName}')`);
    } catch (err) {
      log(`Warning: MCP tool inventory check failed: ${err.message}`);
    }

    try {
      checkPeekabooPermissions();
      log("Peekaboo Bridge Screen Recording Permission: GRANTED");
    } catch (err) {
      log(`Peekaboo Bridge Permission Status: NOT READY (${err.message})`);
    }

    log("Doctor report complete.");
    process.exit(0);
  }

  if (subcommand === "canary-ready") {
    log("Validating canary readiness for Dogfood D1...");

    // 1. Toolchain Check
    try {
      const nodeVer = process.version;
      log(`Node.js version: ${nodeVer}`);
    } catch {
      fail("Node.js missing in environment.");
    }

    // 2. Build Check
    const canaryDistPath = path.join(mcpPkgDir, "dist/src/canary.js");
    if (!fs.existsSync(canaryDistPath)) {
      log("Building MCP package for canary-ready check...");
      execSync("pnpm build", { cwd: mcpPkgDir, stdio: "inherit" });
    }
    if (!fs.existsSync(canaryDistPath)) {
      fail(`Canary dist file missing at ${canaryDistPath}`);
    }

    // 3. MCP Config Verification
    const mcpConfigPath = path.join(rootDir, ".agents/mcp_config.json");
    if (!fs.existsSync(mcpConfigPath)) {
      fail(`.agents/mcp_config.json missing at ${mcpConfigPath}`);
    }

    const mcpConfig = JSON.parse(fs.readFileSync(mcpConfigPath, "utf-8"));
    if (!mcpConfig.mcpServers || !mcpConfig.mcpServers["computer-use-canary"]) {
      fail(`.agents/mcp_config.json must register 'computer-use-canary'`);
    }

    // 4. Public MCP Client Tool Inventory Check
    try {
      const toolName = await verifyPublicMcpToolInventory();
      log(`Verified public MCP tool inventory: Exactly 1 tool ('${toolName}')`);
    } catch (err) {
      fail(`Public MCP Client tool inventory check failed: ${err.message}`);
    }

    // 5. Peekaboo 3.9.1 Binary & Screen Recording Permission Check
    try {
      const peekabooBin = fs.existsSync("/opt/homebrew/bin/peekaboo") ? "/opt/homebrew/bin/peekaboo" : "peekaboo";
      const verOut = execSync(`${peekabooBin} --version`, { encoding: "utf-8" }).trim();
      log(`Verified Peekaboo binary: ${verOut}`);
    } catch {
      fail("Peekaboo binary is not available or executable.");
    }

    try {
      checkPeekabooPermissions();
      log("Verified Peekaboo Screen Recording permission: GRANTED");
    } catch (err) {
      fail(`Peekaboo permissions check failed: ${err.message}`);
    }

    log("ALL CANARY READINESS CHECKS PASSED!");
    process.exit(0);
  }
}

main().catch((err) => {
  fail(err.message);
});
